gt;id_consulta&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="510" y="270" width="155" height="46" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c26" value="&amp;lt;u&amp;gt;id_medicamento&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="270" width="165" height="46" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c27" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="06-Transf-Prescripcion_c25" target="06-Transf-Prescripcion_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c28" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="06-Transf-Prescripcion_c26" target="06-Transf-Prescripcion_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c29" value="dosis" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="480" y="560" width="150" height="44" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c30" value="frecuencia_horas" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="560" width="160" height="44" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c31" value="duracion_dias" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="560" width="150" height="44" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c32" value="cantidad" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="640" width="140" height="44" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c33" value="indicaciones" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="640" width="150" height="44" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c34" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="06-Transf-Prescripcion_c29" target="06-Transf-Prescripcion_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c35" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="06-Transf-Prescripcion_c30" target="06-Transf-Prescripcion_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c36" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="06-Transf-Prescripcion_c31" target="06-Transf-Prescripcion_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c37" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="06-Transf-Prescripcion_c32" target="06-Transf-Prescripcion_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c38" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="06-Transf-Prescripcion_c33" target="06-Transf-Prescripcion_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c39" value="&lt;b&gt;Regla aplicada: Transformación de Relación N:M&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Problema original:&lt;/b&gt; Una consulta puede prescribir muchos medicamentos y un medicamento aparece en muchas consultas. La relación PRESCRIBE contiene atributos descriptivos propios de la dosificación.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Solución:&lt;/b&gt; Se sustituye la relación N:M por una entidad asociativa/intermedia &lt;b&gt;PRESCRIPCION&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Clave Primaria:&lt;/b&gt; Compuesta por las llaves foráneas de ambas entidades intervinientes:&lt;br&gt;PK = &lt;b&gt;(id_consulta, id_medicamento)&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Cardinalidad y Participación:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;CONSULTA -(1) parcial- :&lt;/b&gt; Una consulta puede no requerir medicamentos (ej. control sano).&lt;br&gt;• &lt;b&gt;=(N) total= PRESCRIPCION :&lt;/b&gt; Cada línea de prescripción debe obligatoriamente estar ligada a una consulta y a un fármaco.&lt;br&gt;• &lt;b&gt;-(1) parcial- MEDICAMENTO :&lt;/b&gt; Hay fármacos en inventario que no han sido formulados aún." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="160" width="440" height="720" as_="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>