value="codigo, nombre, precio_venta" style="text;html=1;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;" vertex="1" parent="c81"><mxGeometry x="0" y="50" width="360" height="20" as="geometry" /></mxCell><mxCell id="c84" value="3FN: quitar&lt;br&gt;dependencias transitivas" style="html=1;endArrow=none;fontSize=12;labelBackgroundColor=default;endArrow=block;endFill=0;endSize=14;fontSize=12;fontStyle=1;jumpStyle=arc;jumpSize=10;" edge="1" parent="1" source="c25" target="c41"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c85" value="&lt;b&gt;1FN:&lt;/b&gt; cada celda tiene un solo valor. &lt;b&gt;2FN:&lt;/b&gt; nada depende de solo una parte de la llave. &lt;b&gt;3FN:&lt;/b&gt; nada depende de un atributo que no sea llave. La atención (mascota y veterinario) pasa a CITA y CONSULTA. El resultado completo son las 22 tablas del modelo relacional." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fillColor=none;strokeColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="2300" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>