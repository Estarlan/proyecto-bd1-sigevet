s_="geometry" /></mxCell><mxCell id="05-Transf-Cliente_c25" value="TIENE_TELEFONO" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="580" y="570" width="165" height="82" as_="geometry" /></mxCell><mxCell id="05-Transf-Cliente_c26" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="05-Transf-Cliente_c12" target="05-Transf-Cliente_c25"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="05-Transf-Cliente_c27" value="TELEFONO_CLIENTE" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="550" y="760" width="225" height="68" as_="geometry" /></mxCell><mxCell id="05-Transf-Cliente_c28" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="05-Transf-Cliente_c25" target="05-Transf-Cliente_c27"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="05-Transf-Cliente_c29" value="&amp;lt;u style=&amp;quot;text-decoration:underline dashed&amp;quot;&amp;gt;telefono&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="770" width="170" height="46" as_="geometry" /></mxCell><mxCell id="05-Transf-Cliente_c30" value="tipo_telefono" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="830" width="170" height="46" as_="geometry" /></mxCell><mxCell id="05-Transf-Cliente_c31" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="05-Transf-Cliente_c29" target="05-Transf-Cliente_c27"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="05-Transf-Cliente_c32" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="05-Transf-Cliente_c30" target="05-Transf-Cliente_c27"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="05-Transf-Cliente_c33" value="&lt;b&gt;Reglas aplicadas:&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Atributo multivaluado (telefono):&lt;/b&gt; En 1FN ningún atributo puede tener múltiples valores dentro de la misma tupla. Se extrae a la entidad débil &lt;b&gt;TELEFONO_CLIENTE&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Clave primaria compuesta:&lt;/b&gt; Al ser una entidad débil, su identificación requiere la clave de su dueño más el discriminador:&lt;br&gt;PK = &lt;b&gt;id_cliente + telefono&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Cardinalidad y Participación:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;CLIENTE (1) parcial:&lt;/b&gt; Un cliente recién registrado podría no tener teléfono registrado en el momento.&lt;br&gt;• &lt;b&gt;TELEFONO_CLIENTE (N) total:&lt;/b&gt; Un teléfono no puede existir sin estar asociado a un cliente real." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1280" y="160" width="520" height="680" as_="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="06-Transf-Prescripcion" name="06 - Transf. N:M Prescripción"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="06-Transf-Prescripcion_c11" value="Ejercicio T2 - Transformación de la relación N:M PRESCRIBE (Fórmulas Médicas)" style="text;html=1;align=left;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1500" height="34" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c12" value="CONSULTA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="200" height="62" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c13" value="