 CORRESPONDE_A, ASISTE, FACTURADA_A, EMITIDA_EN, EMITE, CONTIENE, INCLUYE_SERVICIO, INCLUYE_MEDICAMENTO.&lt;br&gt;• &lt;b&gt;3 Relaciones N:M:&lt;/b&gt; CERTIFICADO_EN, PRESCRIBE, ALMACENA." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1800" y="150" width="560" height="400" as_="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="05-Transf-Cliente" name="05 - Transf. Multivaluado CLIENTE"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="05-Transf-Cliente_c11" value="Ejercicio T1 - Transformación del atributo multivaluado 'telefono' de CLIENTE" style="text;html=1;align=left;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1500" height="34" as_="geometry" /></mxCell><mxCell id="05-Transf-Cliente_c12" value="CLIENTE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="380" width="200" height="62" as_="geometry" /></mxCell><mxCell id="05-Transf-Cliente_c13" value="&amp;lt;u&amp;gt;id_cliente&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="280" y="200" width="160" height="46" as_="geometry" /></mxCell><mxCell id="05-Transf-Cliente_c14" value="documento" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="460" y="140" width="160" height="46" as_="geometry" /></mxCell><mxCell id="05-Transf-Cliente_c15" value="nombres" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="140" width="160" height="46" as_="geometry" /></mxCell><mxCell id="05-Transf-C