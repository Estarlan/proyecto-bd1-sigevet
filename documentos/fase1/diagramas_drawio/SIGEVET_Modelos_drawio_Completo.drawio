1" source="06-Transf-Prescripcion_c32" target="06-Transf-Prescripcion_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c38" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="06-Transf-Prescripcion_c33" target="06-Transf-Prescripcion_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="06-Transf-Prescripcion_c39" value="&lt;b&gt;Regla aplicada: Transformación de Relación N:M&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Problema original:&lt;/b&gt; Una consulta puede prescribir muchos medicamentos y un medicamento aparece en muchas consultas. La relación PRESCRIBE contiene atributos descriptivos propios de la dosificación.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Solución:&lt;/b&gt; Se sustituye la relación N:M por una entidad asociativa/intermedia &lt;b&gt;PRESCRIPCION&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Clave Primaria:&lt;/b&gt; Compuesta por las llaves foráneas de ambas entidades intervinientes:&lt;br&gt;PK = &lt;b&gt;(id_consulta, id_medicamento)&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Cardinalidad y Participación:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;CONSULTA -(1) parcial- :&lt;/b&gt; Una consulta puede no requerir medicamentos (ej. control sano).&lt;br&gt;• &lt;b&gt;=(N) total= PRESCRIPCION :&lt;/b&gt; Cada línea de prescripción debe obligatoriamente estar ligada a una consulta y a un fármaco.&lt;br&gt;• &lt;b&gt;-(1) parcial- MEDICAMENTO :&lt;/b&gt; Hay fármacos en inventario que no han sido formulados aún." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="160" width="440" height="720" as_="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="07-Transf-Inventario" name="07 - Transf. N:M Inventario"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="07-Transf-Inventario_c11" value="Ejercicio T3 - Transformación de la relación N:M ALMACENA (Inventario por Sede)" style="text;html=1;align=left;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1500" height="34" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c12" value="SEDE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="200" height="62" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c13" value="&amp;lt;u&amp;gt;id_sede&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="270" width="155" height="48" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c14" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c13" target="07-Transf-Inventario_c12"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c15" value="UBICAR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="390" width="150" height="80" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c16" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c12" target="07-Transf-Inventario_c15"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c17" value="INVENTARIO" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620" y="397" width="210" height="68" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c18" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c15" target="07-Transf-Inventario_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c19" value="CONTENER" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="390" width="160" height="80" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c20" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c17" target="07-Transf-Inventario_c19"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c21" value="MEDICAMENTO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="400" width="200" height="62" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c22" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c19" target="07-Transf-Inventario_c21"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c23" value="&amp;lt;u&amp;gt;id_medicamento&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="270" width="175" height="48" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c24" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c23" target="07-Transf-Inventario_c21"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c25" value="&amp;lt;u&amp;gt;id_sede&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="270" width="150" height="46" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c26" value="&amp;lt;u&amp;gt;id_medicamento&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="270" width="165" height="46" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c27" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c25" target="07-Transf-Inventario_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c28" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c26" target="07-Transf-Inventario_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c29" value="stock_actual" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="560" width="150" height="44" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c30" value="stock_minimo" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="560" width="150" height="44" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c31" value="fecha_actualizacion" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="630" width="180" height="44" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c32" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c29" target="07-Transf-Inventario_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c33" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c30" target="07-Transf-Inventario_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c34" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c31" target="07-Transf-Inventario_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c35" value="&lt;b&gt;Regla aplicada: Inventario Descentralizado por Sede&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Justificación del Negocio:&lt;/b&gt; La red Huella Sana tiene 5 clínicas. Cada sede gestiona su propia existencia física de medicamentos con puntos de reorden y alertas de stock mínimo independientes.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Transformación:&lt;/b&gt; La relación N:M ALMACENA se convierte en la tabla &lt;b&gt;INVENTARIO&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Llave Primaria Compuesta:&lt;/b&gt;&lt;br&gt;PK = &lt;b&gt;(id_sede, id_medicamento)&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Integridad:&lt;/b&gt; Permite verificar con consultas simples cuándo &lt;code&gt;stock_actual &amp;lt;= stock_minimo&lt;/code&gt; para emitir órdenes de compra automáticas." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="160" width="440" height="680" as_="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="08-Transf-Especialidad" name="08 - Transf. N:M Especialidades"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1150" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="08-Transf-Especialidad_c11" value="Ejercicio T4 - Transformación de la relación N:M CERTIFICADO_EN" style="text;html=1;align=left;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1500" height="34" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c12" value="VETERINARIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="400" width="200" height="62" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c13" value="&amp;lt;u&amp;gt;id_empleado&amp;lt;/u&amp;gt;" 