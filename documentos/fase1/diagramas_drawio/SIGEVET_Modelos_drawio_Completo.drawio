le="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="400" width="200" height="62" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c22" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="08-Transf-Especialidad_c19" target="08-Transf-Especialidad_c21"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c23" value="&amp;lt;u&amp;gt;id_especialidad&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="270" width="175" height="48" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c24" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="08-Transf-Especialidad_c23" target="08-Transf-Especialidad_c21"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c25" value="&amp;lt;u&amp;gt;id_empleado&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="270" width="150" height="46" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c26" value="&amp;lt;u&amp;gt;id_especialidad&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="270" width="165" height="46" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c27" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="08-Transf-Especialidad_c25" target="08-Transf-Especialidad_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c28" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="08-Transf-Especialidad_c26" target="08-Transf-Especialidad_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c29" value="fecha_certificacion" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="560" width="180" height="44" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c30" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="08-Transf-Especialidad_c29" target="08-Transf-Especialidad_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c31" value="&lt;b&gt;Regla aplicada: Relación N:M entre Personal y Especialidades&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Supuesto:&lt;/b&gt; Un veterinario puede tener múltiples especialidades (ej. Dermatología y Cirugía) y una especialidad cuenta con múltiples profesionales certificados.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Atributo propio:&lt;/b&gt; La fecha en que el médico obtuvo la acreditación (&lt;code&gt;fecha_certificacion&lt;/code&gt;) describe el cruce exacto entre el profesional y la disciplina.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Llave Primaria:&lt;/b&gt; Compuesta por:&lt;br&gt;PK = &lt;b&gt;(id_empleado, id_especialidad)&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="160" width="440" height="650" as_="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="09-Entidad-Debil-Factura" name="09 - Entidad Débil Factura"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="09-Entidad-Debil-Factura_c11" value="Ejercicio T5 - Entidad Débil DETALLE_FACTURA y Arco Exclusivo" style="text;html=1;align=left;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1500" height="34" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c12" value="FACTURA" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="280" width="200" height="62" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c13" value="&amp;lt;u&amp;gt;id_factura&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="160" width="160" height="46" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c14" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c13" target="09-Entidad-Debil-Factura_c12"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c15" value="CONTIENE" style="shape=rhombus;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="460" width="160" height="80" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c16" value="(1) total" style="shape=link;html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c12" target="09-Entidad-Debil-Factura_c15"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c17" value="DETALLE_FACTURA" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="660" width="220" height="68" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c18" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c15" target="09-Entidad-Debil-Factura_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c19" value="&amp;lt;u style=&amp;quot;text-decoration:underline dashed&amp;quot;&amp;gt;num_linea&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="660" width="150" height="46" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c20" value="cantidad" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="725" width="140" height="44" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c21" value="precio_unitario" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="785" width="150" height="44" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c22" value="descuento_pct" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="340" y="840" width="150" height="44" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c23" value="subtotal" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="850" width="140" height="44" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c24" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c19" target="09-Entidad-Debil-Factura_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c25" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c20" target="09-Entidad-Debil-Factura_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c26" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c21" target="09-Entidad-Debil-Factura_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c27" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c22" target="09-Entidad-Debil-Factura_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c28" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c23" target="09-Entidad-Debil-Factura_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c29" value="INCLUYE_SERVICIO" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="175" height="75" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c30" value="(N) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c17" target="09-Entidad-Debil-Factura_c29"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c31" value="SERVICIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="605" width="190" height="60" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c32" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c29" target="09-Entidad-Debil-Factura_c31"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c33" value="INCLUYE_MEDICAMENTO" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="730" width="185" height="75" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c34" value="(N) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c17" target="09-Entidad-Debil-Factura_c33"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c35" value="MEDICAMENTO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="735" width="190" height="60" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c36" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c33" target="09-Entidad-Debil-Factura_c35"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c37" value="&lt;b&gt;Reglas aplicadas: Entidad Débil y Arco Exclusivo&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Entidad Débil:&lt;/b&gt; DETALLE_FACTURA no tiene significado ni existencia por sí misma sin FACTURA. Su clave primaria completa se compone de:&lt;br&gt;PK = &lt;b&gt;id_factura + num_linea&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Arco Exclusivo (XOR):&lt;/b&gt; Cada renglón de cobro en una factura ampara &lt;b&gt;un servicio O un medicamento&lt;/b&gt;, pero nunca los dos al mismo tiempo.&lt;br&gt;En la base de datos se implementa con la restricción:&lt;br&gt;&lt;code&gt;CHECK ((id_servicio IS NOT NULL AND id_medicamento IS NULL) OR (id_servicio IS NULL AND id_medicamento IS NOT NULL))&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Atributo Derivado (subtotal):&lt;/b&gt; Calculado como:&lt;br&gt;&lt;code&gt;cantidad * precio_unitario * (1 - descuento_pct / 100)&lt;/code&gt;." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1450" y="160" width="500" height="780" as_="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="10-EER-Especializacion" name="10 - EER Especialización Empleado"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2050" pageHeight="1250" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="10-EER-Especializacion_c11" value="Ejercicio T6 - Especialización / Generalización de EMPLEADO (Jerarquía Parcial y Exclusiva)" style="text;html=1;align=left;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1500" height="34" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c12" value="EMPLEADO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="220" width="200" height="62" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c13" value="&amp;lt;u&amp;gt;id_empleado&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="110" width="160" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c14" value="nombre_completo" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="70" width="160" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c15" value="tipo_empleado" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="110" width="160" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c16" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c13" target="10-EER-Especializacion_c12"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c17" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c14" target="10-EER-Especializacion_c12"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c18" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c15" target="10-EER-Especializacion_c12"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c19" value="SER" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="370" y="420" width="165" height="82" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c20" value="SER" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="960" y="420" width="165" height="82" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c21" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c12" target="10-EER-Especializacion_c19"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c22" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c12" target="10-EER-Especializacion_c20"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c23" value="VETERINARIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="620" width="215" height="68" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c24" value="AUXILIAR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="620" width="215" height="68" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c25" value="(1) total" style="shape=link;html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c19" target="10-EER-Especializacion_c23"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c26" value="(1) total" style="shape=link;html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c20" target="10-EER-Especializacion_c24"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c27" value="tarjeta_profesional" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="570" width="170" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c28" value="universidad" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="640" width="160" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c29" value="anio_graduacion" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="710" width="160" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c30" value="&amp;lt;u&amp;gt;id_empleado&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="350" y="780" width="160" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c31" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c27" target="10-EER-Especializacion_c23"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c32" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c28" target="10-EER-Especializacion_c23"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c33" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c29" target="10-EER-Especializacion_c23"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c34" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c30" target="10-EER-Especializacion_c23"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c35" value="area" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="570" width="160" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c36" value="turno" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="640" width="160" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c37" value="certificacion" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="710" width="160" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c38" value="&amp;lt;u&amp;gt;id_empleado&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="780" width="160" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c39" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c35" target="10-EER-Especializacion_c24"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c40" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c36" target="10-EER-Especializacion_c24"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c41" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c37" target="10-EER-Especializacion_c24"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c42" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c38" target="10-EER-Especializacion_c24"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c43" value="&lt;b&gt;Regla aplicada: Especialización con Opción 8A (Elmasri &amp; Navathe)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Supertipo y Subtipos:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Supertipo:&lt;/b&gt; EMPLEADO almacena los datos comunes a todo el personal (cédula, nombres, salario, sede).&lt;br&gt;• &lt;b&gt;Subtipos:&lt;/b&gt; VETERINARIO (médicos) y AUXILIAR (asistentes).&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Tipo de Jerarquía:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Parcial:&lt;/b&gt; Un empleado puede ser de tipo administrativo ('ADM'), por lo que no pertenece a ningún subtipo. Participación de EMPLEADO es parcial (línea simple).&lt;br&gt;• &lt;b&gt;Exclusiva (Disjunta):&lt;/b&gt; Un empleado es veterinario o es auxiliar, pero no ambos simultáneamente.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Mapeo a Tablas (Opción 8A):&lt;/b&gt;&lt;br&gt;Se crea una tabla para la superclase y una tabla para cada subclase. Las tablas hijas heredan la clave primaria &lt;b&gt;id_empleado&lt;/b&gt; como PK y FK simultáneamente." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="160" width="520" height="850" as_="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>