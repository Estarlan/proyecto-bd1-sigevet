TO, nunca ambos (CHECK ck_df_tipo_item).&lt;br&gt;• &lt;b&gt;total y subtotal:&lt;/b&gt; Atributos derivados, se calculan dinámicamente.&lt;br&gt;• &lt;b&gt;PRESCRIBE:&lt;/b&gt; Relación N:M con dosis, frecuencia, duración e indicaciones." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1520" y="120" width="520" height="420" as_="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="04-Chen-Global" name="04 - Chen Arquitectura Global"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2500" pageHeight="1600" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="04-Chen-Global_c11" value="SIGEVET - Vista Arquitectónica Global (Entidades y Relaciones)" style="text;html=1;align=left;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1500" height="34" as_="geometry" /></mxCell><mxCell id="04-Chen-Global_c12" value="DEPARTAMENTO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="170" height="50" as_="geometry" /></mxCell><mxCell id="04-Chen-Global_c13" value="PERTENECE_A" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="145" width="140" height="60" as_="geometry" /></mxCell><mxCell id="04-Chen-Global_c14" value="CIUDAD" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="540" y="150" width="170" height="50" as_="geometry" /></mxCell><mxCell id="04-Chen-Global_c15" value="(1)" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="04-Chen-Global_c12" target="04-Chen-Global_c13"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell