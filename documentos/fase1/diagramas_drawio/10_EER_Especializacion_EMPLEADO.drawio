cion_c23"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c34" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c30" target="10-EER-Especializacion_c23"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c35" value="area" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="570" width="160" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c36" value="turno" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="640" width="160" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c37" value="certificacion" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1200" y="710" width="160" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c38" value="&amp;lt;u&amp;gt;id_empleado&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="780" width="160" height="46" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c39" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c35" target="10-EER-Especializacion_c24"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c40" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c36" target="10-EER-Especializacion_c24"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c41" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c37" target="10-EER-Especializacion_c24"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c42" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="10-EER-Especializacion_c38" target="10-EER-Especializacion_c24"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="10-EER-Especializacion_c43" value="&lt;b&gt;Regla aplicada: Especialización con Opción 8A (Elmasri &amp; Navathe)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Supertipo y Subtipos:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Supertipo:&lt;/b&gt; EMPLEADO almacena los datos comunes a todo el personal (cédula, nombres, salario, sede).&lt;br&gt;• &lt;b&gt;Subtipos:&lt;/b&gt; VETERINARIO (médicos) y AUXILIAR (asistentes).&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Tipo de Jerarquía:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;Parcial:&lt;/b&gt; Un empleado puede ser de tipo administrativo ('ADM'), por lo que no pertenece a ningún subtipo. Participación de EMPLEADO es parcial (línea simple).&lt;br&gt;• &lt;b&gt;Exclusiva (Disjunta):&lt;/b&gt; Un empleado es veterinario o es auxiliar, pero no ambos simultáneamente.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Mapeo a Tablas (Opción 8A):&lt;/b&gt;&lt;br&gt;Se crea una tabla para la superclase y una tabla para cada subclase. Las tablas hijas heredan la clave primaria &lt;b&gt;id_empleado&lt;/b&gt; como PK y FK simultáneamente." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="160" width="520" height="850" as_="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>