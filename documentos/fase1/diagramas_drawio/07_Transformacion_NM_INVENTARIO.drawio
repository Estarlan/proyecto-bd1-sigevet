lor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="270" width="150" height="46" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c26" value="&amp;lt;u&amp;gt;id_medicamento&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="270" width="165" height="46" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c27" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c25" target="07-Transf-Inventario_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c28" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c26" target="07-Transf-Inventario_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c29" value="stock_actual" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="560" width="150" height="44" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c30" value="stock_minimo" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="730" y="560" width="150" height="44" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c31" value="fecha_actualizacion" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="630" width="180" height="44" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c32" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c29" target="07-Transf-Inventario_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c33" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c30" target="07-Transf-Inventario_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c34" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="07-Transf-Inventario_c31" target="07-Transf-Inventario_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="07-Transf-Inventario_c35" value="&lt;b&gt;Regla aplicada: Inventario Descentralizado por Sede&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Justificación del Negocio:&lt;/b&gt; La red Huella Sana tiene 5 clínicas. Cada sede gestiona su propia existencia física de medicamentos con puntos de reorden y alertas de stock mínimo independientes.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Transformación:&lt;/b&gt; La relación N:M ALMACENA se convierte en la tabla &lt;b&gt;INVENTARIO&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Llave Primaria Compuesta:&lt;/b&gt;&lt;br&gt;PK = &lt;b&gt;(id_sede, id_medicamento)&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;4. Integridad:&lt;/b&gt; Permite verificar con consultas simples cuándo &lt;code&gt;stock_actual &amp;lt;= stock_minimo&lt;/code&gt; para emitir órdenes de compra automáticas." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="160" width="440" height="680" as_="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>