t;id_empleado&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="540" y="270" width="150" height="46" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c26" value="&amp;lt;u&amp;gt;id_especialidad&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="270" width="165" height="46" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c27" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="08-Transf-Especialidad_c25" target="08-Transf-Especialidad_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c28" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="08-Transf-Especialidad_c26" target="08-Transf-Especialidad_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c29" value="fecha_certificacion" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="560" width="180" height="44" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c30" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="08-Transf-Especialidad_c29" target="08-Transf-Especialidad_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="08-Transf-Especialidad_c31" value="&lt;b&gt;Regla aplicada: Relación N:M entre Personal y Especialidades&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Supuesto:&lt;/b&gt; Un veterinario puede tener múltiples especialidades (ej. Dermatología y Cirugía) y una especialidad cuenta con múltiples profesionales certificados.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Atributo propio:&lt;/b&gt; La fecha en que el médico obtuvo la acreditación (&lt;code&gt;fecha_certificacion&lt;/code&gt;) describe el cruce exacto entre el profesional y la disciplina.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Llave Primaria:&lt;/b&gt; Compuesta por:&lt;br&gt;PK = &lt;b&gt;(id_empleado, id_especialidad)&lt;/b&gt;." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1480" y="160" width="440" height="650" as_="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>