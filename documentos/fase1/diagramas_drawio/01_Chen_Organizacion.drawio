n_c114" value="descripcion" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="1090" width="140" height="42" as_="geometry" /></mxCell><mxCell id="01-Organizacion_c115" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="01-Organizacion_c112" target="01-Organizacion_c110"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="01-Organizacion_c116" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="01-Organizacion_c113" target="01-Organizacion_c110"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="01-Organizacion_c117" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="01-Organizacion_c114" target="01-Organizacion_c110"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="01-Organizacion_c118" value="&lt;b&gt;Reglas del Área Organización:&lt;/b&gt;&lt;br&gt;• &lt;b&gt;DIRIGE (1:1):&lt;/b&gt; Cada sede tiene exactamente 1 director (participación total en SEDE, parcial en EMPLEADO).&lt;br&gt;• &lt;b&gt;LABORA_EN (1:N):&lt;/b&gt; Todo empleado pertenece a una sede (total en ambos lados).&lt;br&gt;• &lt;b&gt;Especialización EMPLEADO:&lt;/b&gt; Subtipos VETERINARIO y AUXILIAR con herencia de clave id_empleado (Opción 8A).&lt;br&gt;• &lt;b&gt;CERTIFICADO_EN (N:M):&lt;/b&gt; Relación con atributo propio fecha_certificacion.&lt;br&gt;• &lt;b&gt;antiguedad:&lt;/b&gt; Atributo derivado (elipse punteada)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1720" y="120" width="430" height="420" as_="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>