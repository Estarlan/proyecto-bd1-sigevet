lue="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c20" target="09-Entidad-Debil-Factura_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c26" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c21" target="09-Entidad-Debil-Factura_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c27" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c22" target="09-Entidad-Debil-Factura_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c28" value="" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c23" target="09-Entidad-Debil-Factura_c17"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c29" value="INCLUYE_SERVICIO" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="600" width="175" height="75" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c30" value="(N) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c17" target="09-Entidad-Debil-Factura_c29"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c31" value="SERVICIO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="605" width="190" height="60" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c32" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c29" target="09-Entidad-Debil-Factura_c31"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c33" value="INCLUYE_MEDICAMENTO" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="820" y="730" width="185" height="75" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c34" value="(N) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c17" target="09-Entidad-Debil-Factura_c33"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c35" value="MEDICAMENTO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1120" y="735" width="190" height="60" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c36" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="09-Entidad-Debil-Factura_c33" target="09-Entidad-Debil-Factura_c35"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="09-Entidad-Debil-Factura_c37" value="&lt;b&gt;Reglas aplicadas: Entidad Débil y Arco Exclusivo&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;1. Entidad Débil:&lt;/b&gt; DETALLE_FACTURA no tiene significado ni existencia por sí misma sin FACTURA. Su clave primaria completa se compone de:&lt;br&gt;PK = &lt;b&gt;id_factura + num_linea&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;2. Arco Exclusivo (XOR):&lt;/b&gt; Cada renglón de cobro en una factura ampara &lt;b&gt;un servicio O un medicamento&lt;/b&gt;, pero nunca los dos al mismo tiempo.&lt;br&gt;En la base de datos se implementa con la restricción:&lt;br&gt;&lt;code&gt;CHECK ((id_servicio IS NOT NULL AND id_medicamento IS NULL) OR (id_servicio IS NULL AND id_medicamento IS NOT NULL))&lt;/code&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;3. Atributo Derivado (subtotal):&lt;/b&gt; Calculado como:&lt;br&gt;&lt;code&gt;cantidad * precio_unitario * (1 - descuento_pct / 100)&lt;/code&gt;." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1450" y="160" width="500" height="780" as_="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>