<mxfile host="app.diagrams.net" agent="antigravity" version="24.0.0"><diagram id="00-Leyenda" name="00 - Leyenda Notación Chen"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="00-Leyenda_c11" value="Leyenda - Notación Peter Chen (Estándar Bases de Datos 1 - Universidad El Bosque)" style="text;html=1;align=left;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="20" width="1500" height="34" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c12" value="ENTIDAD_FUERTE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="90" width="200" height="60" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c13" value="&lt;b&gt;Rectángulo simple:&lt;/b&gt; Entidad fuerte. Posee atributo clave propio y existencia independiente." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="100" width="800" height="40" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c14" value="ENTIDAD_DÉBIL" style="shape=ext;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="175" width="200" height="60" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c15" value="&lt;b&gt;Rectángulo doble:&lt;/b&gt; Entidad débil o asociativa resultante de transformar relaciones N:M o atributos multivaluados." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="185" width="800" height="40" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c16" value="RELACIONAR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="260" width="200" height="65" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c17" value="&lt;b&gt;Rombo simple:&lt;/b&gt; Relación estándar. Se nombra con verbo en infinitivo." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="272" width="800" height="40" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c18" value="IDENTIFICAR" style="shape=rhombus;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="345" width="200" height="65" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c19" value="&lt;b&gt;Rombo doble:&lt;/b&gt; Relación identificadora que une una entidad débil con su propietaria (ej. CONTIENE para DETALLE_FACTURA)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="357" width="800" height="40" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c20" value="atributo_simple" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="430" width="200" height="45" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c21" value="&lt;b&gt;Elipse simple:&lt;/b&gt; Atributo atómico." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="435" width="800" height="40" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c22" value="&amp;lt;u&amp;gt;id_clave_pk&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="500" width="200" height="45" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c23" value="&lt;b&gt;Elipse con texto subrayado:&lt;/b&gt; Atributo identificador principal (Clave Primaria)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="505" width="800" height="40" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c24" value="&amp;lt;u style=&amp;quot;text-decoration:underline dashed&amp;quot;&amp;gt;clave_parcial&amp;lt;/u&amp;gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="570" width="200" height="45" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c25" value="&lt;b&gt;Elipse con subrayado punteado:&lt;/b&gt; Discriminador o clave parcial de una entidad débil." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="575" width="800" height="40" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c26" value="edad_derivado" style="ellipse;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="70" y="640" width="200" height="45" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c27" value="&lt;b&gt;Elipse punteada:&lt;/b&gt; Atributo calculado o derivado (no se almacena para evitar inconsistencias y cumplir 3FN)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="645" width="800" height="40" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c28" value="telefono_multival" style="shape=ellipse;double=1;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="710" width="200" height="45" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c29" value="&lt;b&gt;Elipse doble:&lt;/b&gt; Atributo multivaluado antes de normalizar/transformar." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="310" y="715" width="800" height="40" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c30" value="ENTIDAD_A" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="70" y="800" width="180" height="55" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c31" value="ASOCIAR" style="rhombus;whiteSpace=wrap;html=1;fillColor=none;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="795" width="140" height="65" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c32" value="ENTIDAD_B" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="560" y="800" width="180" height="55" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c33" value="(1) parcial" style="html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="00-Leyenda_c30" target="00-Leyenda_c31"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c34" value="(N) total" style="shape=link;html=1;endArrow=none;fontSize=12;fontStyle=1;" edge="1" parent="1" source="00-Leyenda_c31" target="00-Leyenda_c32"><mxGeometry relative="1" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c35" value="&lt;b&gt;Línea simple = Participación Parcial (mínimo 0).&lt;/b&gt;&lt;br&gt;&lt;b&gt;Línea doble = Participación Total (mínimo 1).&lt;/b&gt;&lt;br&gt;Cardinalidad indicada entre paréntesis: (1) o (N)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="780" y="790" width="600" height="75" as_="geometry" /></mxCell><mxCell id="00-Leyenda_c36" value="&lt;b&gt;Reglas de Diseño aplicadas en SIGEVET:&lt;/b&gt;&lt;br&gt;1. En el modelo relacional físico resultante no existen atributos compuestos, multivaluados ni derivados.&lt;br&gt;2. Las relaciones N:M se transforman en tablas intermedias con llaves foráneas compuestas.&lt;br&gt;3. Las entidades hijas heredan la clave primaria en relaciones 1:1 de especialización (Opción 8A)." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;fillColor=none;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="900" width="1310" height="90" as_="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>