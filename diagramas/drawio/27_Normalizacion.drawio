<mxfile host="app.diagrams.net" agent="Codex" version="29.0.0"><diagram name="27 Normalización hasta 3FN" id="sigevet-page-00"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1120" guides="1" connect="1" arrows="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" parent="1" vertex="1" value="SIGEVET · Normalización de la orden de atención y factura" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;"><mxGeometry x="45" y="20" width="1710" height="42" as="geometry" /></mxCell><mxCell id="c2" parent="1" vertex="1" value="El desarrollo de dependencias funcionales se conserva en el capítulo de modelo relacional del informe." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;"><mxGeometry x="45" y="65" width="1710" height="55" as="geometry" /></mxCell><mxCell id="c3" parent="1" vertex="1" value="&lt;b&gt;0FN&lt;/b&gt;&lt;hr&gt;Orden de atención&lt;br&gt;Grupos repetitivos de ítems&lt;br&gt;Varios teléfonos por cliente" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;rounded=0;fontSize=20;spacing=20;"><mxGeometry x="100" y="170" width="650" height="240" as="geometry" /></mxCell><mxCell id="c4" parent="1" vertex="1" value="&lt;b&gt;1FN&lt;/b&gt;&lt;hr&gt;ORDEN_1FN(num_factura, num_linea, ...)&lt;br&gt;Una fila por ítem&lt;br&gt;TELEFONO_1FN(doc_cliente, telefono)" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;rounded=0;fontSize=20;spacing=20;"><mxGeometry x="980" y="170" width="650" height="240" as="geometry" /></mxCell><mxCell id="c5" parent="1" vertex="1" value="&lt;b&gt;2FN&lt;/b&gt;&lt;hr&gt;FACTURA_2FN · DETALLE_2FN · ITEM_2FN&lt;br&g