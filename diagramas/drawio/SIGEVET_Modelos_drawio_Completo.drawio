mxCell><mxCell id="c68" parent="1" vertex="1" value="UQn agrupa atributos de una misma restricción UNIQUE; PK compuesta comparte #. CHECK, disparadores y reglas de negocio se documentan en el DDL y el informe." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="50" y="3240" width="2600" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="MER lógico · Barker · comercial" id="sigevet-page-18"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2700" pageHeight="3350" guides="1" connect="1" arrows="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" parent="1" vertex="1" value="SIGEVET — MER lógico · Barker" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;"><mxGeometry x="50" y="30" width="2600" height="45" as="geometry" /></mxCell><mxCell id="c2" parent="1" vertex="1" value="# PK / identificador · * obligatorio · o opcional · FK foránea · UQn grupo único" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="50" y="90" width="2600" height="30" as="geometry" /></mxCell><mxCell id="c3" parent="1" vertex="1" value="Barker: pata sin barras = muchos; sin pata = uno; mitad continua = obligatoria; mitad discontinua = opcional." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="50" y="135" width="2600" height="45" as="geometry" /></mxCell><mxCell id="c4" parent="1" vertex="1" value="Cardinalidades del DDL: un padre admite 0 hijos; U