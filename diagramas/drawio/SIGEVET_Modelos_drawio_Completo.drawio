=ERzeroToMany;endArrow=ERzeroToOne;startSize=16;endSize=16;dashed=1;"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="3215" y="1630.73" /><mxPoint x="3215" y="320" /><mxPoint x="3215" y="320" /><mxPoint x="3215" y="540.62" /></Array></mxGeometry></mxCell><mxCell id="c60" parent="1" vertex="1" value="UQn agrupa atributos de una misma restricción UNIQUE; PK compuesta comparte #. CHECK, disparadores y reglas de negocio se documentan en el DDL y el informe." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="50" y="3240" width="3940" height="50" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Modelo relacional · MySQL 8.4 · organizacion" id="sigevet-page-24"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2700" pageHeight="3350" guides="1" connect="1" arrows="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" parent="1" vertex="1" value="SIGEVET — Modelo relacional · MySQL 8.4" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;"><mxGeometry x="50" y="30" width="2600" height="45" as="geometry" /></mxCell><mxCell id="c2" parent="1" vertex="1" value="# PK / identificador · * obligatorio · o opcional · FK foránea · UQn grupo único" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="50" y="90" width="2600" height="30" as="geometry" /></mxCell><mxCell id="c3" parent="1" vertex="1" value="Extremos: || = 1 · o| = 0..1 · o&lt; = 0..N. Línea continua: FK incluida en PK; discontinua: relación no identificadora." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="50" y="135" width="2600" height="45" as="geometry" /></mxCell><mxCell id="c4" parent="1" vertex="1" value="Cardinalidades del DDL: un padre admite 0 hijos; UNIQUE reduce N a 1. Las participaciones mínimas del MER conceptual requieren reglas adicionales." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="50" y="195" width="2600" height="45" as="geometry" /></mxCell><mxCell id="c5" parent="1" vertex="1" value="ORGANIZACION" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry x="80" y="260" width="1100" height="35" as="geometry" /></mxCell><mxCell id="c6" parent="1" vertex="1" value="REFERENCIAS EXTERNAS" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry x="1400" y="260" width="1100" height="35" as="geometry" /></mxCell><mxCell id="c7" parent="1" vertex="1" value="&lt;b&gt;DEPARTAMENTO&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;# id_departamento : INT &lt;small&gt;[PK]&lt;/small&gt;&lt;br&gt;* codigo_dane : CHAR(2) &lt;small&gt;[UQ1]&lt;/small&gt;&lt;br&gt;* nombre : VARCHAR(60) &lt;small&gt;[UQ2]&lt;/small&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;rounded=0;arcSize=12;fillColor=#e2efff;verticalAlign=top;spacingTop=12;spacingLeft=14;spacingRight=12;fontSize=16;align=left;"><mxGeometry x="80" y="440" width="500" height="119" as="geometry" /></mxCell><mxCell id="c8" parent="1" vertex="1" value="&lt;b&gt;ESPECIALIDAD&