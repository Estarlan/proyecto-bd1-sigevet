<mxfile host="app.diagrams.net" agent="Codex" version="29.0.0"><diagram name="00 Leyenda y lectura" id="sigevet-page-00"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1550" pageHeight="1200" guides="1" connect="1" arrows="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" parent="1" vertex="1" value="SIGEVET · Notación y organización de los modelos" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;"><mxGeometry x="45" y="20" width="1460" height="42" as="geometry" /></mxCell><mxCell id="c2" parent="1" vertex="1" value="Fuentes: supuestos del proyecto, modelo conceptual y DDL MySQL. Las referencias SEDE/CUADRILLA orientan la notación visual." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;"><mxGeometry x="45" y="65" width="1460" height="55" as="geometry" /></mxCell><mxCell id="c3" parent="1" vertex="1" value="ENTIDAD FUERTE" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;rounded=0;fontStyle=1;"><mxGeometry x="75" y="140" width="210" height="58" as="geometry" /></mxCell><mxCell id="c4" parent="1" vertex="1" value="Rectángulo simple: identificador propio." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="370" y="140" width="1070" height="60" as="geometry" /></mxCell><mxCell id="c5" parent="1" vertex="1" value="ENTIDAD DÉBIL" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;rounded=0;fontStyle=1;shape=ext;double=1;"><mxGeometry x="75" y="240" width="210" height="58" as="geometry" /></mxCell><mxCell id="c6" parent="1" vertex="1" value="Rectángulo doble: DETALLE_FACTURA depende de FACTURA y num_linea." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="370" y="240" width="1070" height="60" as="geometry" /></mxCell><mxCell id="c7" parent="1" vertex="1" value="RELACIÓN" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;rhombus;fontSize=12;fillColor=#f2f7fa;"><mxGeometry x="90" y="330" width="180" height="78" as="geometry" /></mxCell><mxCell id="c8" parent="1" vertex="1" value="Rombo simple; doble en la identificadora CONTIENE." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="370" y="340" width="1070" height="60" as="geometry" /></mxCell><mxCell id="c9" parent="1" vertex="1" value="&lt;u&gt;llave&lt;/u&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;ellipse;fontSize=12;"><mxGeometry x="90" y="440" width="190" height="44" as="geometry" /></mxCell><mxCell id="c10" parent="1" vertex="1" value="Atributo clave subrayado." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="370" y="440" width="1070" height="60" as="geometry" /></mxCell><mxCell id="c11" parent="1" vertex="1" value="&lt;span style=&quot;text-decoration:underline dashed&quot;&gt;parcial&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;ellipse;fontSize=12;"><mxGeometry x="90" y="540" width="190" height="44" as="geometry" /></mxCell><mxCell id="c12" parent="1" vertex="1" value="Llave parcial: subrayado discontinuo, no contorno discontinuo." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="370" y="540" width="1070" height="60" as="geometry" /></mxCell><mxCell id="c13" parent="1" vertex="1" value="multivaluado" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;ellipse;fontSize=12;shape=doubleEllipse;"><mxGeometry x="90" y="640" width="190" height="44" as="geometry" /></mxCell><mxCell id="c14" parent="1" vertex="1" value="Elipse doble: telefono de CLIENTE, antes de su transformación." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="370" y="640" width="1070" height="60" as="geometry" /></mxCell><mxCell id="c15" parent="1" vertex="1" value="derivado" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;ellipse;fontSize=12;dashed=1;"><mxGeometry x="90" y="740" width="190" height="44" as="geometry" /></mxCell><mxCell id="c16" parent="1" vertex="1" value="Elipse discontinua: edad, antiguedad, subtotal y total." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="370" y="740" width="1070" height="60" as="geometry" /></mxCell><mxCell id="c17" parent="1" vertex="1" value="Chen: (1), (N), (M) expresan la razón de cardinalidad. Línea simple: participación parcial; doble: total." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="75" y="890" width="1400" height="65" as="geometry" /></mxCell><mxCell id="c18" parent="1" vertex="1" value="EER: (min,max) se lee en la entidad adyacente. Círculo d: especialización disyunta; línea simple desde EMPLEADO: parcial." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="75" y="970" width="1400" height="65" as="geometry" /></mxCell><mxCell id="c19" parent="1" vertex="1" value="Los modelos lógicos y físicos muestran las 22 tablas. Una tabla asociativa no se clasifica como entidad débil solo por proceder de N:M." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="75" y="1050" width="1400" height="65" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="01 Chen Organización" id="sigevet-page-01"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1550" pageHeight="1630" guides="1" connect="1" arrows="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" parent="1" vertex="1" value="SIGEVET · 01 Chen Organización" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;"><mxGeometry x="45" y="20" width="1460" height="42" as="geometry" /></mxCell><mxCell id="c2" parent="1" vertex="1" value="Cada fila amplía una relación. Las entidades repetidas son referencias a la misma entidad del modelo global." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=14;"><mxGeometry x="45" y="65" width="1460" height="55" as="geometry" /></mxCell><mxCell id="c3" parent="1" vertex="1" value="DEPARTAMENTO" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#f