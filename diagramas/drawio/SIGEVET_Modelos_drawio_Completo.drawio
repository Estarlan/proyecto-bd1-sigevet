ial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#52616b;rounded=0;jumpStyle=arc;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c11" parent="1" edge="1" source="c6" target="c9" value="⊂" style="html=1;endArrow=none;startArrow=none;fontFamily=Arial;fontSize=13;labelBackgroundColor=#ffffff;strokeColor=#52616b;rounded=0;jumpStyle=arc;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="c12" parent="1" vertex="1" value="VET: tarjeta_profesional, universidad, anio_graduacion" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="120" y="640" width="620" height="60" as="geometry" /></mxCell><mxCell id="c13" parent="1" vertex="1" value="AUX: area, certificacion, turno" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="870" y="640" width="560" height="60" as="geometry" /></mxCell><mxCell id="c14" parent="1" vertex="1" value="d: un empleado no pertenece a ambos subtipos. ADM permanece solo en EMPLEADO. PK del subtipo = FK a EMPLEADO." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="100" y="750" width="1300" height="60" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="11 Atributos Organización" id="sigevet-page-11"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="2360" pageHeight="3540" guides="1" connect="1" arrows="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="c1" parent="1" vertex="1" value="SIGEVET · 11 Atributos Organización" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff