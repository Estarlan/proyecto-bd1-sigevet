ta = uno; mitad continua = obligatoria; mitad discontinua = opcional." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="50" y="135" width="2600" height="45" as="geometry" /></mxCell><mxCell id="c4" parent="1" vertex="1" value="Cardinalidades del DDL: un padre admite 0 hijos; UNIQUE reduce N a 1. Las participaciones mínimas del MER conceptual requieren reglas adicionales." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="50" y="195" width="2600" height="45" as="geometry" /></mxCell><mxCell id="c5" parent="1" vertex="1" value="CLINICA" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry x="80" y="260" width="1100" height="35" as="geometry" /></mxCell><mxCell id="c6" parent="1" vertex="1" value="REFERENCIAS EXTERNAS" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry x="1400" y="260" width="1100" height="35" as="geometry" /></mxCell><mxCell id="c7" parent="1" vertex="1" value="&lt;b&gt;CLIENTE&lt;/b&gt;&lt;hr&gt;&lt;div style=&quot;text-align:left&quot;&gt;# id_cliente &lt;small&gt;[PK]&lt;/small&gt;&lt;br&gt;* tipo_documento &lt;small&gt;[UQ1]&lt;/small&gt;&lt;br&gt;* num_documento &lt;small&gt;[UQ1]&lt;/small&gt;&lt;br&gt;* nombres&lt;br&gt;* apellidos&lt;br&gt;o email &lt;small&gt;[UQ2]&lt;/small&gt;&lt;br&gt;* direccion&lt;br&gt;* id_ciudad &lt;small&gt;[FK]&lt;/small&gt;&lt;br&gt;* fecha_registro&lt;/div&gt;" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffff