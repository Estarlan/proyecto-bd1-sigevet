lColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;"><mxGeometry x="50" y="30" width="2600" height="45" as="geometry" /></mxCell><mxCell id="c2" parent="1" vertex="1" value="# PK / identificador · * obligatorio · o opcional · FK foránea · UQn grupo único" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="50" y="90" width="2600" height="30" as="geometry" /></mxCell><mxCell id="c3" parent="1" vertex="1" value="Extremos: || = 1 · o| = 0..1 · o&lt; = 0..N. Línea continua: FK incluida en PK; discontinua: relación no identificadora." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="50" y="135" width="2600" height="45" as="geometry" /></mxCell><mxCell id="c4" parent="1" vertex="1" value="Cardinalidades del DDL: un padre admite 0 hijos; UNIQUE reduce N a 1. Las participaciones mínimas del MER conceptual requieren reglas adicionales." style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=16;"><mxGeometry x="50" y="195" width="2600" height="45" as="geometry" /></mxCell><mxCell id="c5" parent="1" vertex="1" value="COMERCIAL" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeometry x="80" y="260" width="1100" height="35" as="geometry" /></mxCell><mxCell id="c6" parent="1" vertex="1" value="REFERENCIAS EXTERNAS" style="html=1;whiteSpace=wrap;fontFamily=Arial;fontSize=14;strokeColor=#263238;fillColor=#ffffff;text;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;"><mxGeomet